{
  "name": "c-through",
  "displayName": "C Through",
  "description": "Source Insight-style relational function call tree and reference visualizer for C/C++ code",
  "version": "1.1.0",
  "publisher": "devtools",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/local/c-through" },
  "engines": { "vscode": "^1.75.0" },
  "categories": ["Other", "Visualization"],
  "keywords": ["C", "C++", "function", "call tree", "relational", "source insight", "reference", "c through"],
  "activationEvents": [
    "onLanguage:c",
    "onLanguage:cpp",
    "onCommand:cThrough.showTree",
    "onCommand:cThrough.showCallees",
    "onCommand:cThrough.showCallers",
    "onCommand:cThrough.analyzeDirectory",
    "onView:cThroughView"
  ],
  "main": "./src/extension.js",
  "contributes": {
    "commands": [
      { "command": "cThrough.showTree",          "title": "C Through: Show Relational Tree",           "icon": "$(type-hierarchy)" },
      { "command": "cThrough.showCallees",        "title": "C Through: Show Functions Called By This",  "icon": "$(arrow-down)" },
      { "command": "cThrough.showCallers",        "title": "C Through: Show Functions Calling This",    "icon": "$(arrow-up)" },
      { "command": "cThrough.analyzeFile",        "title": "C Through: Analyze Current File",           "icon": "$(file-code)" },
      { "command": "cThrough.analyzeWorkspace",   "title": "C Through: Analyze Entire Workspace",       "icon": "$(search)" },
      { "command": "cThrough.analyzeDirectory",   "title": "C Through: Analyze This Directory",         "icon": "$(folder-opened)" },
      { "command": "cThrough.rescan",             "title": "C Through: Re-scan Last Scope",             "icon": "$(refresh)" }
    ],
    "views": {
      "explorer": [
        {
          "id": "cThroughView",
          "name": "C Through",
          "icon": "$(type-hierarchy)",
          "contextualTitle": "C Through — Function Relations"
        }
      ]
    },
    "menus": {
      "editor/context": [
        { "command": "cThrough.showTree",    "when": "resourceLangId == c || resourceLangId == cpp", "group": "c_through@1" },
        { "command": "cThrough.showCallees", "when": "resourceLangId == c || resourceLangId == cpp", "group": "c_through@2" },
        { "command": "cThrough.showCallers", "when": "resourceLangId == c || resourceLangId == cpp", "group": "c_through@3" }
      ],
      "explorer/context": [
        {
          "command": "cThrough.analyzeDirectory",
          "when": "explorerResourceIsFolder",
          "group": "c_through@1"
        }
      ],
      "view/title": [
        { "command": "cThrough.analyzeWorkspace", "when": "view == cThroughView", "group": "navigation@1" },
        { "command": "cThrough.analyzeDirectory", "when": "view == cThroughView", "group": "navigation@2" },
        { "command": "cThrough.rescan",           "when": "view == cThroughView", "group": "navigation@3" },
        { "command": "cThrough.analyzeFile",      "when": "view == cThroughView", "group": "navigation@4" }
      ]
    },
    "configuration": {
      "title": "C Through",
      "properties": {
        "cThrough.maxDepth": {
          "type": "number",
          "default": 5,
          "description": "Maximum depth for call tree traversal."
        },
        "cThrough.showStdLib": {
          "type": "boolean",
          "default": false,
          "description": "Include standard library calls (printf, malloc, etc.) in the tree."
        },
        "cThrough.autoRefresh": {
          "type": "boolean",
          "default": true,
          "description": "Incrementally re-parse a file when it is saved."
        },
        "cThrough.includeGlob": {
          "type": "string",
          "default": "**/*.{c,h,cpp,hpp}",
          "description": "Glob pattern for files to include when scanning. E.g. 'src/**/*.c'"
        },
        "cThrough.excludeGlob": {
          "type": "string",
          "default": "**/node_modules/**",
          "description": "Glob pattern for paths to exclude. E.g. '{**/build/**,**/third_party/**}'"
        }
      }
    }
  },
  "devDependencies": {
    "@vscode/vsce": "^3.9.1"
  }
}
