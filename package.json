{
  "name": "c-through",
  "displayName": "C Through",
  "icon": "images/icon.png",
  "description": "Relational function call tree and reference visualizer for C/C++ code",
  "version": "2.3.3",
  "publisher": "ShanjidArefin",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ShihabKuet/c-through"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "C",
    "C++",
    "function",
    "call tree",
    "relational",
    "source insight",
    "reference",
    "c through"
  ],
  "activationEvents": [
    "onLanguage:c",
    "onLanguage:cpp"
  ],
  "main": "./src/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "cThrough.showTree",
        "title": "C Through: Show Relational Tree",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "cThrough.showCallees",
        "title": "C Through: Show Functions Called By This",
        "icon": "$(arrow-down)"
      },
      {
        "command": "cThrough.showCallers",
        "title": "C Through: Show Functions Calling This",
        "icon": "$(arrow-up)"
      },
      {
        "command": "cThrough.analyzeFile",
        "title": "C Through: Analyze Current File",
        "icon": "$(file-code)"
      },
      {
        "command": "cThrough.analyzeWorkspace",
        "title": "C Through: Analyze Entire Workspace",
        "icon": "$(globe)"
      },
      {
        "command": "cThrough.analyzeDirectory",
        "title": "C Through: Analyze This Directory",
        "icon": "$(folder-opened)"
      },
      {
        "command": "cThrough.rescan",
        "title": "C Through: Re-scan Last Scope",
        "icon": "$(refresh)"
      },
      {
        "command": "cThrough.toggleCodeLens",
        "title": "C Through: Toggle CodeLens",
        "icon": "$(eye)"
      },
      {
        "command": "cThrough.searchSidebar",
        "title": "C Through: Search Sidebar",
        "icon": "$(search)"
      },
      {
        "command": "cThrough.showDeadCodeReport",
        "title": "C Through: Show Dead Code Report",
        "icon": "$(warning)"
      },
      {
        "command": "cThrough.configureKeybindings",
        "title": "C Through: Configure Keyboard Shortcuts",
        "icon": "$(keyboard)"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "cThroughControls",
          "name": "C Through: Search & Filter",
          "type": "webview",
          "icon": "$(search)",
          "contextualTitle": "C Through \u2014 Search & Filter"
        },
        {
          "id": "cThroughView",
          "name": "C Through",
          "icon": "$(type-hierarchy)",
          "contextualTitle": "C Through \u2014 Function Relations"
        }
      ]
    },
    "menus": {
      "editor/context": [
        {
          "command": "cThrough.showTree",
          "when": "resourceLangId == c || resourceLangId == cpp",
          "group": "c_through@1"
        },
        {
          "command": "cThrough.showCallees",
          "when": "resourceLangId == c || resourceLangId == cpp",
          "group": "c_through@2"
        },
        {
          "command": "cThrough.showCallers",
          "when": "resourceLangId == c || resourceLangId == cpp",
          "group": "c_through@3"
        }
      ],
      "explorer/context": [
        {
          "command": "cThrough.analyzeDirectory",
          "when": "explorerResourceIsFolder",
          "group": "c_through@1"
        }
      ],
      "view/title": [
        {
          "command": "cThrough.analyzeWorkspace",
          "when": "view == cThroughView",
          "group": "navigation@1"
        },
        {
          "command": "cThrough.analyzeDirectory",
          "when": "view == cThroughView",
          "group": "navigation@2"
        },
        {
          "command": "cThrough.rescan",
          "when": "view == cThroughView",
          "group": "navigation@3"
        },
        {
          "command": "cThrough.analyzeFile",
          "when": "view == cThroughView",
          "group": "navigation@4"
        },
        {
          "command": "cThrough.toggleCodeLens",
          "when": "view == cThroughView",
          "group": "navigation@5"
        },
        {
          "command": "cThrough.searchSidebar",
          "when": "view == cThroughView",
          "group": "navigation@6"
        },
        {
          "command": "cThrough.showDeadCodeReport",
          "when": "view == cThroughView",
          "group": "navigation@7"
        }
      ]
    },
    "keybindings": [
      {
        "command": "cThrough.searchSidebar",
        "key": "ctrl+alt+s",
        "mac": "cmd+alt+s"
      }
    ],
    "configuration": {
      "title": "C Through",
      "properties": {
        "cThrough.maxDepth": {
          "type": "number",
          "default": 5,
          "description": "Maximum depth for call tree traversal."
        },
        "cThrough.showStdLib": {
          "type": "boolean",
          "default": false,
          "description": "Include standard library calls (printf, malloc, etc.) in the tree."
        },
        "cThrough.autoRefresh": {
          "type": "boolean",
          "default": true,
          "description": "Incrementally re-parse a file when it is saved."
        },
        "cThrough.includeGlob": {
          "type": "string",
          "default": "**/*.{c,h,cpp,hpp}",
          "description": "Glob pattern for files to include when scanning. E.g. 'src/**/*.c'"
        },
        "cThrough.excludeGlob": {
          "type": "string",
          "default": "**/node_modules/**",
          "description": "Glob pattern for paths to exclude. E.g. '{**/build/**,**/third_party/**}'"
        },
        "cThrough.enableCodeLens": {
          "type": "boolean",
          "default": true,
          "description": "Show inline CodeLens above every C/C++ function (callers, calls, complexity, dead code warnings)."
        },
        "cThrough.syncCursor": {
          "type": "boolean",
          "default": true,
          "description": "Sync the sidebar selection with the editor cursor — selecting a function or global in code highlights it in the C Through tree."
        },
        "cThrough.maxLinesPerFile": {
          "type": "number",
          "default": 8000,
          "description": "Maximum lines to parse per file. Files larger than this are truncated. Increase for large codebases."
        }
      }
    }
  },
  "devDependencies": {
    "@vscode/vsce": "^3.9.1"
  }
}